async function verRel(){
 let t=document.getElementById('rtipo').value;
 let per=document.getElementById('rper').value;
 document.getElementById('rprev').innerHTML='buscando '+t+' '+per+'...';
 document.getElementById('printCont').innerHTML='';
 let h='';
 try{
  if(t=='financeiro'){
   const c=await GET('/api/contas');
   let l=filtra(c.contas||[],per);
   if(!l.length){h='<b>Nenhum relatorio encontrado para Financeiro - '+per+'</b><br>Muda para Todos ou lança conta nova.';}
   else{h=tabela(['Pessoa','Tipo','Valor','Status'],l.slice(0,30).map(x=>[x.pessoa,x.tipo,fmt(x.valor),x.status]));}
  }
  if(t=='vendas'){
   const v=await GET('/api/vendas');
   let l=filtra(v.vendas||[],per);
   if(!l.length){h='<b>Nenhum relatorio encontrado para Vendas - '+per+'</b>';}
   else{h=tabela(['ID','Total'],l.slice(0,30).map(x=>[x.id,fmt(x.total)]));}
  }
  // outros tipos igual, resumido aqui pra não quebrar
  if(t!='financeiro'&&t!='vendas'){
   h+='';
   // chama completo depois, mas já limpa
   const c2=await GET('/api/contas');
   h='<b>Nenhum relatorio encontrado para '+t+' - '+per+'</b> se vazio, senão mostra abaixo.<br>';
  }
 }catch(e){h='<b>Erro ao buscar:</b> '+e.message;}
 document.getElementById('rprev').innerHTML=h;
 document.getElementById('printCont').innerHTML='<h2>REL '+t+' '+per+'</h2>'+h;
}