async function verRel(){
 let t=document.getElementById('rtipo').value;
 let per=document.getElementById('rper').value;
 document.getElementById('rprev').innerHTML='buscando...';
 document.getElementById('printCont').innerHTML='';
 let h='';
 try{
  if(t=='vendas'){
   const v=await GET('/api/vendas');
   let l=filtra(v.vendas||[],per);
   if(!l.length){h='<b>Nenhum relatório encontrado para Vendas - '+per+'</b><br>Tenta Todos ou cadastra venda no /admin.';}
   else{let tot=l.reduce((a,x)=>a+parseFloat(x.total||0),0);h='Total '+fmt(tot)+' Qtd '+l.length+'<br>'+tabela(['ID','Cliente','Total'],l.slice(0,30).map(x=>[x.id,x.cliente_nome||'',fmt(x.total)]));}
  }
  if(t=='financeiro'){
   const c=await GET('/api/contas');
   let l=filtra(c.contas||[],per);
   if(!l.length){h='<b>Nenhum relatório encontrado para Financeiro - '+per+'</b>';}
   else{h=tabela(['Pessoa','Tipo','Valor'],l.slice(0,30).map(x=>[x.pessoa,x.tipo,fmt(x.valor)]));}
  }
  if(t=='estoque'){
   const p=await GET('/api/produtos');
   let l=filtra(p.produtos||[],per);
   if(!l.length){h='<b>Nenhum relatório encontrado para Estoque - '+per+'</b>';}
   else{h=tabela(['Nome','Preço'],l.slice(0,30).map(x=>[x.nome,fmt(x.preco_venda)]));}
  }
  if(t=='ponto'){
   const r=await GET('/api/rh/ponto_calc');
   let l=filtra(r.ponto||[],per);
   if(!l.length && !(r.ajustes||[]).length){h='<b>Nenhum relatório encontrado para Ponto - '+per+'</b>';}
   else{h=tabela(['Data','Mat'],l.slice(0,20).map(x=>[x.data,x.funcionario_matricula]));}
  }
  if(t=='fiscal'){
   const n=await GET('/api/nf_lista');
   let l=filtra(n.notas||[],per);
   if(!l.length){h='<b>Nenhum relatório encontrado para Fiscal - '+per+'</b><br>Emite 1 NF primeiro.';}
   else{h=tabela(['Tipo','Num'],l.slice(0,20).map(x=>[x.tipo,x.numero]));}
  }
  if(t=='contratos'){
   const c=await GET('/api/contratos_lista');
   let l=filtra(c.contratos||[],per);
   if(!l.length){h='<b>Nenhum relatório encontrado para Contratos</b>';}
   else{h=tabela(['ID','Cliente'],l.map(x=>[x.id,x.cliente]));}
  }
  if(t=='agenda'){
   const a=await GET('/api/agenda_lista');
   let l=filtra(a.eventos||[],per);
   if(!l.length){h='<b>Nenhum relatório encontrado para Agenda - '+per+'</b>';}
   else{h=tabela(['Titulo','Inicio'],l.map(x=>[x.titulo,x.inicio]));}
  }
  if(t=='bancos'){
   const b=await GET('/api/bancos/config');
   if(!(b.configs||[]).length){h='<b>Nenhum relatório encontrado para Bancos</b><br>Salva 1 chave em Integrações.';}
   else{h=tabela(['Tipo','Prov'],(b.configs||[]).map(x=>[x.tipo,x.provedor]));}
  }
  if(t=='producao'){
   const pr=await GET('/api/producao/acompanhamento');
   let l=pr.ordens||[];
   if(!l.length){h='<b>Nenhum relatório encontrado para Produção</b><br>Inicia 1 ordem em Produção.';}
   else{h=tabela(['Produto','Qtd'],l.slice(0,20).map(x=>[x.produto_nome,x.qtd_pronta+'/'+x.qtd_meta]));}
  }
  if(t=='auditoria'){
   const a=await GET('/api/auditoria_resumo');
   if(!(a.vendas||[]).length){h='<b>Nenhum relatório encontrado para Auditoria</b>';}
   else{h=tabela(['ID','Total'],(a.vendas||[]).slice(0,20).map(x=>[x.id,fmt(x.total)]));}
  }
 }catch(e){h='<b>Erro ao buscar relatório:</b> '+e.message;}
 document.getElementById('rprev').innerHTML=h;
 document.getElementById('printCont').innerHTML='<h2>REL '+t+' '+per+'</h2>'+h;
}