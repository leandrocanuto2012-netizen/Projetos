
function filtra(l,per){
 if(!l) return [];
 if(per=='todos') return l;
 let h=new Date();h.setHours(0,0,0,0);
 return l.filter(o=>{
  let raw=pegaData(o);
  if(!raw) return false;
  let d=new Date(raw);
  if(isNaN(d)) return false;
  if(per=='hoje') return d>=h;
  if(per=='7d'){let x=new Date();x.setDate(x.getDate()-7);return d>=x;}
  if(per=='30d'){let x=new Date();x.setDate(x.getDate()-30);return d>=x;}
  if(per=='mes'){let n=new Date();return d.getMonth()==n.getMonth()&&d.getFullYear()==n.getFullYear();}
  return true;
 });
}



