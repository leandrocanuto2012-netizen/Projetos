async function telaRel(){
 document.getElementById('tela').innerHTML='<h3>Relatorios Gerenciais - todas funcoes</h3>'
 +'<div class="noprint">Tipo <select id="rtipo">'
 +'<option value="vendas_loja">Vendas Loja</option>'
 +'<option value="vendas_site">Vendas Site</option>'
 +'<option value="financeiro_receber">A Receber</option>'
 +'<option value="financeiro_pagar">A Pagar</option>'
 +'<option value="clientes">Clientes</option>'
 +'<option value="funcionarios">Funcionarios</option>'
 +'<option value="ferias">Ferias RH</option>'
 +'<option value="fornecedores">Fornecedores</option>'
 +'<option value="estoque">Produtos / Estoque</option>'
 +'<option value="ponto">Ponto / RH</option>'
 +'<option value="fiscal">Fiscal NF / DRE</option>'
 +'<option value="contratos">Contratos</option>'
 +'<option value="agenda">Agenda</option>'
 +'<option value="bancos">Bancos</option>'
 +'<option value="producao">Producao</option>'
 +'</select> '
 +'Periodo <select id="rper"><option value="todos">Todos</option><option value="hoje">Hoje</option><option value="7d">Ultimos 7 dias</option><option value="30d">Ultimos 30 dias</option><option value="mes">Este mes</option></select> '
 +'<button class="btn" onclick="verRel()">Ver Preview</button> <button class="btn" onclick="window.print()">Imprimir / PDF</button></div>'
 +'<div id="rprev" class="preview">Escolhe e clica Ver Preview...</div>';
}
async function verRel(){
 let t=document.getElementById('rtipo').value;
 let per=document.getElementById('rper').value;
 document.getElementById('rprev').innerHTML='buscando '+t+'...';
 document.getElementById('printCont').innerHTML='';
 let h='';
 try{
  if(t=='vendas_loja'){
   const v=await GET('/api/vendas'); let l=filtra(v.vendas||[],per);
   if(!l.length)h='<b>Nenhum relatorio encontrado para Vendas Loja - '+per+'</b>';
   else h=tabela(['ID','Cliente','Total','Status'],l.slice(0,30).map(x=>[x.id,x.cliente_nome||'',fmt(x.total),x.status||'']));
  }
  if(t=='vendas_site'){
   const s=await GET('/api/site/pedidos'); let l=filtra(s.pedidos||[],per);
   if(!l.length)h='<b>Nenhum relatorio encontrado para Vendas Site - '+per+'</b>';
   else h=tabela(['ID','Cliente','Total','Status'],l.slice(0,30).map(x=>[x.id,x.cliente_nome||'',fmt(x.total),x.status||'']));
  }
  if(t=='financeiro_receber'){
   const c=await GET('/api/contas'); let l=filtra((c.contas||[]).filter(x=>x.tipo=='RECEBER'),per);
   if(!l.length)h='<b>Nenhum relatorio encontrado para A Receber - '+per+'</b>';
   else h=tabela(['Pessoa','Valor','Venc','Status'],l.slice(0,30).map(x=>[x.pessoa,fmt(x.valor),x.vencimento||'',x.status]));
  }
  if(t=='financeiro_pagar'){
   const c=await GET('/api/contas'); let l=filtra((c.contas||[]).filter(x=>x.tipo=='PAGAR'),per);
   if(!l.length)h='<b>Nenhum relatorio encontrado para A Pagar - '+per+'</b>';
   else h=tabela(['Pessoa','Valor','Venc','Status'],l.slice(0,30).map(x=>[x.pessoa,fmt(x.valor),x.vencimento||'',x.status]));
  }
  if(t=='clientes'){
   const r=await GET('/api/clientes'); let l=filtra(r.clientes||[],per);
   if(!l.length)h='<b>Nenhum relatorio encontrado para Clientes</b>';
   else h=tabela(['Nome','Telefone'],l.slice(0,30).map(x=>[x.nome,x.telefone||'']));
  }
  if(t=='funcionarios'){
   const r=await GET('/api/funcionarios'); let l=r.funcionarios||[];
   if(!l.length)h='<b>Nenhum relatorio encontrado para Funcionarios</b>';
   else h=tabela(['Mat','Nome','Salario'],l.slice(0,30).map(x=>[x.matricula,x.nome,fmt(x.salario)]));
  }
  if(t=='ferias'){
   const r=await GET('/api/rh/ferias'); let l=filtra(r.ferias||r.ponto||[],per);
   if(!l.length)h='<b>Nenhum relatorio encontrado para Ferias - '+per+'</b>';
   else h=tabela(['Mat','Inicio','Fim'],l.slice(0,30).map(x=>[x.funcionario_matricula||x.matricula,x.inicio||x.data,x.fim||'']));
  }
  if(t=='fornecedores'){
   const r=await GET('/api/fornecedores'); let l=r.fornecedores||[];
   if(!l.length)h='<b>Nenhum relatorio encontrado para Fornecedores</b>';
   else h=tabela(['Nome','Telefone'],l.slice(0,30).map(x=>[x.nome,x.telefone||'']));
  }
  if(t=='estoque'){
   const p=await GET('/api/produtos'); let l=filtra(p.produtos||[],per);
   if(!l.length)h='<b>Nenhum relatorio encontrado para Estoque</b>';
   else h=tabela(['Nome','Preco','Status'],l.slice(0,30).map(x=>[x.nome,fmt(x.preco_venda),x.status]));
  }
  if(t=='ponto'){
   const r=await GET('/api/rh/ponto_calc'); let l=filtra(r.ponto||[],per);
   if(!l.length)h='<b>Nenhum relatorio encontrado para Ponto - '+per+'</b>';
   else h=tabela(['Data','Mat','Ent','Sai'],l.slice(0,20).map(x=>[x.data,x.funcionario_matricula,x.entrada,x.saida]));
  }
  if(t=='fiscal'){
   const n=await GET('/api/nf_lista'); let l=filtra(n.notas||[],per);
   if(!l.length)h='<b>Nenhum relatorio encontrado para Fiscal - '+per+'</b>';
   else h=tabela(['Tipo','Num','Total'],l.slice(0,20).map(x=>[x.tipo,x.numero,fmt(x.total)]));
  }
  if(t=='contratos'){
   const c=await GET('/api/contratos_lista'); let l=filtra(c.contratos||[],per);
   if(!l.length)h='<b>Nenhum relatorio encontrado para Contratos</b>';
   else h=tabela(['ID','Cliente','Valor'],l.map(x=>[x.id,x.cliente,fmt(x.valor)]));
  }
  if(t=='agenda'){
   const a=await GET('/api/agenda_lista'); let l=filtra(a.eventos||[],per);
   if(!l.length)h='<b>Nenhum relatorio encontrado para Agenda - '+per+'</b>';
   else h=tabela(['Titulo','Inicio'],l.map(x=>[x.titulo,x.inicio]));
  }
  if(t=='bancos'){
   const b=await GET('/api/bancos/config');
   if(!(b.configs||[]).length)h='<b>Nenhum relatorio encontrado para Bancos</b>';
   else h=tabela(['Tipo','Prov'],(b.configs||[]).map(x=>[x.tipo,x.provedor]));
  }
  if(t=='producao'){
   const pr=await GET('/api/producao/acompanhamento');
   if(!(pr.ordens||[]).length)h='<b>Nenhum relatorio encontrado para Producao</b>';
   else h=tabela(['Produto','Qtd'],(pr.ordens||[]).slice(0,20).map(x=>[x.produto_nome,x.qtd_pronta+'/'+x.qtd_meta]));
  }
 }catch(e){h='<b>Erro ao buscar:</b> '+e.message;}
 document.getElementById('rprev').innerHTML=h;
 document.getElementById('printCont').innerHTML='<h2>REL '+t+' '+per+'</h2>'+h;
}