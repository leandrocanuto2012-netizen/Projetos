# Copie este arquivo para .env e preencha com seus dados

# === SUPABASE (PostgreSQL) - use esta opcao ===
# Cole sua Connection string do Supabase aqui:
# DATABASE_URI=postgresql://postgres.xxxx:senha@aws-0-xxxx.pooler.supabase.com:5432/postgres

# === MYSQL local - use esta opcao (comente a acima) ===
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASS=root123
# DB_NAME=panificadora_db

# Porta do servidor API
PORT=8080
